{
  "name": "jamesim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm test:sim",
    "assets:robot": "node scripts/convert-robot.mjs",
    "assets:field": "node scripts/convert-field.mjs",
    "benchmark:drive": "node scripts/benchmark-drive.mjs",
    "benchmark:shoot": "node scripts/benchmark-shooter.mjs",
    "benchmark:practice": "node scripts/benchmark-shooter.mjs --practice",
    "test:unit": "vitest run src/sim/MatchRules.test.ts src/sim/MatchCues.test.ts src/settings.test.ts src/field/collisionAsset.test.ts src/view/MatchAudio.test.ts",
    "test:sim": "pnpm assets:check && vitest run --maxWorkers=1 --testTimeout=30000",
    "assets:check": "node scripts/check-assets.mjs",
    "assets:check:release": "node scripts/check-assets.mjs --release",
    "build:release": "pnpm assets:check:release && pnpm build && pnpm check:build",
    "build:local": "pnpm assets:check && pnpm build && pnpm check:build",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "meshoptimizer": "1.3.0",
    "occt-import-js": "0.0.23",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "26.x"
  }
}
